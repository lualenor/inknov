// =============================================================
//  Inknov — Esquema de base de datos (Prisma ORM)
//  Privacidad por usuario: todo lo que crea un usuario queda
//  aislado mediante las relaciones userId / projectId.
//
//  Producción (Neon / PostgreSQL): provider = "postgresql"
//  Desarrollo local sin servidor:  provider = "sqlite"
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Usuario de la plataforma. Nadie más puede leer sus proyectos.
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  projects     Project[]
  notes        Note[]
  images       ImageAsset[]
}

/// Carpeta / proyecto de escritura ("Diario personal", "Poemas"…)
model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  icon        String   @default("📖")
  color       String   @default("#F5C044")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       Note[]

  @@index([userId, updatedAt])
}

/// Nota / texto libre dentro de un proyecto.
/// contentJson guarda el documento del editor (Tiptap JSON).
model Note {
  id          String       @id @default(cuid())
  projectId   String
  userId      String
  title       String       @default("Sin título")
  contentJson String       @default("")
  plainText   String       @default("")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  images      ImageAsset[]

  @@index([projectId, updatedAt])
  @@index([userId])
}

/// Imagen subida por el usuario (JPG/PNG).
/// storage = "db"   → los bytes viven en la base de datos (modo sin configuración)
/// storage = "blob" → los bytes viven en Vercel Blob y blobUrl guarda el enlace
model ImageAsset {
  id        String   @id @default(cuid())
  userId    String
  noteId    String?
  mimeType  String
  size      Int
  width     Int      @default(0)
  height    Int      @default(0)
  storage   String   @default("db")
  data      Bytes?
  blobUrl   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([noteId])
}
